# 智能体本地工作数据，不入库
#.agents/
.workbuddy/

# 评审产物与本地测试素材，不入库
# 写成 `test/` 会匹配**任意层级**的 test 目录——`apps/worker/test/`、`apps/web/test/`、
# `packages/shared/test/` 三个测试套件会被一起忽略，以后新增的测试文件静默不入库。
# 故用前导斜杠锚定仓库根：只忽略根下那个素材目录。
deliverables/
/test/
.zcodeignore
# 诊断与真浏览器实测的临时产物（截图、复现页等），不入库
.tmp/

# 依赖与构建产物
node_modules/
dist/
dist-types/
*.tsbuildinfo

# Wrangler / Cloudflare 本地产物与机密
.wrangler/
.dev.vars
.dev.vars.*
# 示例文件必须入库：一键部署页据此提示需要填哪些机密（架构 §15.5）
!.dev.vars.example

